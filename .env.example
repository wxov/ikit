# 复制本文件为 .env 并按需修改（真实 .env 已加入 .gitignore，不会提交）

# ---- LLM（DeepSeek / 任意 OpenAI 兼容接口）----
LLM_API_KEY=sk-xxx
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- Embedding（SiliconFlow BGE-M3，可选，启用向量检索）----
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ---- 知识库存储（json / sqlite）----
KB_STORAGE=sqlite

# ---- 草稿可见性（完善⑦）----
# admin-only（默认）：草稿仅站主可见，非 admin 的列表/搜索/分类计数/评论/详情/Agent 检索全部过滤
# everyone：草稿全员可见（= 回滚为完善⑦ 之前的行为，一句话回滚）
KB_DRAFT_VISIBILITY=admin-only

# ---- 存量草稿迁移（完善⑦，启动时幂等执行一次）----
# publish（默认）：把「上线前创建且 status='draft'」的历史条目一次性改判为 published（写前自动备份）
# off：跳过迁移，**且不写幂等标记**（便于日后手动开启）
# 回滚三步：停服 → 还原 data/ 下的 <存储文件>.bak-<yyyyMMddTHHmmss> 备份 → KB_DRAFT_VISIBILITY=everyone 启动
KB_MIGRATE_DRAFT_STATUS=publish

# ---- 服务 ----
PORT=3000
HOST=0.0.0.0
# 前端静态目录（生产同源托管；默认 apps/web/dist，构建产物缺失时自动退回纯 API 模式）
WEB_DIST=

# ---- 账号（初始站主账号 / 重置密码邮件链接基准地址）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
APP_URL=

# ---- SMTP（找回密码发信；未配置时不发邮件、接口直接返回 resetToken）----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- 第三方插件包目录（默认 <项目根>/plugins，示例 plugins/hello）----
PLUGIN_DIR=

# ---- 插件市场（静态目录源，可选）----
# 静态插件市场目录源 registry.json 的 URL；空=关闭远端源（仅保留内置 7 条目录，行为不变）
PLUGIN_REGISTRY_URL=
# 本地调试豁免：=1 时允许经 http://（明文）下载插件包；生产环境请勿开启
PLUGIN_REGISTRY_ALLOW_HTTP=

# ---- 插件签名（完善⑥ · ed25519）----
# 验签策略：off=不验签（完全等价本功能上线前）/ warn=验签但不拒装，仅状态+日志+徽标（默认）/ enforce=未签名或验签失败一律拒装（HTTP 400 + PLUGIN_SIGNATURE_* 码）
PLUGIN_SIGNATURE_MODE=warn
# 单个信任公钥：PEM 单行（字面 \n 亦可）或 base64 SPKI；keyId 由公钥派生（ikit- + sha256(SPKI DER)[:16]），无需手工填
PLUGIN_SIGNING_PUBKEY=
# 单个信任公钥的文件形态（与 `node scripts/gen-plugin-key.mjs` 的输出天然配套）
# ⚠️ 私钥放 .keys/plugin-signing.key.pem，**绝不入库、绝不放进 .env**（.keys/ 已 gitignore）
PLUGIN_SIGNING_PUBKEY_FILE=
# 多密钥/轮换过渡：JSON 映射 {"<keyId>":"<base64 SPKI>" 或 {"publicKey":"…","status":"active|retired"}}
# 优先级：PLUGIN_SIGNING_KEYS > PLUGIN_SIGNING_PUBKEY(_FILE) > 内置信任表（src/trusted-keys.ts，默认空）
PLUGIN_SIGNING_KEYS=

# ---- 热更新（更新类型 hot/hard；硬更新安装包地址）----
UPDATE_KIND=hot
UPDATE_INSTALLER_URL=
UPDATE_INSTALLER_URL_TAURI=
UPDATE_INSTALLER_URL_ANDROID=
UPDATE_INSTALLER_URL_WEB=
