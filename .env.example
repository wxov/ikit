# 复制本文件为 .env 并按需修改（真实 .env 已加入 .gitignore，不会提交）

# ---- LLM（DeepSeek / 任意 OpenAI 兼容接口）----
LLM_API_KEY=sk-xxx
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- Embedding（SiliconFlow BGE-M3，可选，启用向量检索）----
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ---- 知识库存储（json / sqlite）----
KB_STORAGE=sqlite

# ---- 服务 ----
PORT=3000
HOST=0.0.0.0
