<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- 运行时主题（BridgeActivity 在 onCreate 中 setTheme(AppTheme.NoActionBar)） -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>

        <!-- 刘海 / 挖孔屏（API 28+）：允许窗口延伸到屏幕短边区域。
             与前端 index.html 的 viewport-fit=cover + env(safe-area-inset-*) 配套；
             旧系统忽略该属性，不报错。 -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>

        <!-- Android 15（targetSdk 35）起强制 edge-to-edge：显式退出强制，
             让状态栏 / 手势条区域由系统 decor 占位，WebView 不再画到系统栏之下（顶栏/底栏不再被遮挡）。
             该属性为 API 35 引入（xmlns:tools 仅用于抑制低版本 lint 告警）；Android 16 若将来 targetSdk=36
             会忽略此退出标记 → 兜底见 capacitor.config.ts 的 android.adjustMarginsForEdgeToEdge。 -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>